---
import Site from './Site.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<Site title={`${title} — Vibe Coding for Adults`} description={description} analytics={false}>
  <main id="main" class="wrap">
    <article class="information-prose">
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</Site>
<style>
.information-prose{max-width:680px;margin:auto;padding:72px 0 88px}
.information-prose h1{font-size:64px}
.information-prose :global(h2){font-size:28px;margin:48px 0 20px}
.information-prose :global(p){margin:0 0 24px}
.information-prose :global(.lead){font-size:23px;line-height:1.5}
@media(max-width:600px){.information-prose{padding:48px 0}.information-prose h1{font-size:40px}.information-prose :global(.lead){font-size:21px}}
</style>
